package tests;

use ecosystem::bigint::{BigInt};
use ecosystem::decimal::{Decimal};
use std::testing;

#[test]
fn downstream_exact_quotients_fit_after_scale_adjustment() -> () {
    let tiny = testing::expect_ok(Decimal::new(BigInt::from_i64(10), 4096), "tiny");
    let result = testing::expect_ok(tiny.div_exact(Decimal::from_i64(10)), "finite quotient");
    testing::assert_eq(result.scale(), 4096);
    testing::assert_eq(result.coefficient(), BigInt::one());
    let huge = testing::expect_ok(Decimal::new(BigInt::one(), -4096), "huge");
    let tenth = testing::expect_ok(Decimal::parse("0.1"), "tenth");
    let result = testing::expect_ok(huge.div_exact(tenth), "finite huge quotient");
    testing::assert_eq(result.scale(), -4096);
    testing::assert_eq(result.coefficient(), BigInt::from_i64(10));
}
