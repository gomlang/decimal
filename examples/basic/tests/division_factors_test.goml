package tests;

use ecosystem::decimal::{Decimal, Error};
use ecosystem::bigint::{BigInt};
use std::testing;

#[test]
fn exact_division_handles_large_binary_and_mixed_decimal_factors() -> () {
    let binary = testing::expect_ok(BigInt::one().shl(4096), "large binary denominator");
    for sign in Vec::from_array([1, -1]) {
        let denominator = testing::expect_ok(
            Decimal::new(binary.mul(BigInt::from_i64(sign)), 0),
            "denominator",
        );
        let quotient = testing::expect_ok(Decimal::one().div_exact(denominator), "exact reciprocal");
        testing::assert_eq(quotient.scale(), 4096);
        // Verify the exact decimal representation with an integer identity.
        testing::assert_eq(
            quotient.coefficient().mul(denominator.coefficient()),
            testing::expect_ok(BigInt::pow10(4096), "power ten"),
        );
    }
    let mixed = testing::expect_ok(BigInt::one().shl(2048), "binary factor").mul(
        testing::expect_ok(BigInt::from_i64(5).pow(512), "decimal factor"),
    );
    let quotient = testing::expect_ok(
        Decimal::one().div_exact(testing::expect_ok(Decimal::new(mixed, 0), "mixed denominator")),
        "mixed reciprocal",
    );
    testing::assert_eq(quotient.scale(), 2048);
    testing::assert_eq(
        quotient.coefficient(),
        testing::expect_ok(BigInt::from_i64(5).pow(1536), "exact coefficient"),
    );
    let numerator = testing::expect_ok(
        Decimal::new(testing::expect_ok(BigInt::one().shl(1024), "common numerator"), 0),
        "numerator",
    );
    let quotient = testing::expect_ok(
        numerator.div_exact(testing::expect_ok(Decimal::new(binary, 0), "denominator")),
        "common factor cancellation",
    );
    testing::assert_eq(quotient.scale(), 3072);
    testing::assert_eq(
        quotient.coefficient(),
        testing::expect_ok(BigInt::from_i64(5).pow(3072), "reduced coefficient"),
    );
}

#[test]
fn exact_division_keeps_binary_factor_budget_and_recurring_errors() -> () {
    let maximum = testing::expect_ok(
        Decimal::new(testing::expect_ok(BigInt::one().shl(8192), "allowed factors"), 0),
        "denominator",
    );
    let huge = testing::expect_ok(Decimal::new(BigInt::one(), -4096), "large numerator");
    testing::assert_eq(
        testing::expect_err(huge.div_exact(maximum), "coefficient cannot fit"),
        Error::Overflow,
    );
    let beyond = testing::expect_ok(BigInt::one().shl(8193), "excess factors");
    for odd in Vec::from_array([1, 3]) {
        let denominator = testing::expect_ok(
            Decimal::new(beyond.mul(BigInt::from_i64(odd)), 0),
            "excess denominator",
        );
        testing::assert_eq(
            testing::expect_err(Decimal::one().div_exact(denominator), "factor budget"),
            Error::LimitExceeded("exact division factors"),
        );
    }
    let recurring = testing::expect_ok(
        Decimal::new(
            testing::expect_ok(BigInt::one().shl(4096), "binary factor").mul(BigInt::from_i64(3)),
            0,
        ),
        "recurring denominator",
    );
    testing::assert_eq(
        testing::expect_err(Decimal::one().div_exact(recurring), "remaining odd factor"),
        Error::NonTerminating,
    );
}
